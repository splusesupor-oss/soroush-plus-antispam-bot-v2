# ============================================================
#  محرمانه — هرگز نباید وارد مخزن عمومی شود
# ============================================================
# سشن، توکن، کلید API و نسخه‌های پشتیبان آن‌ها.
# توجه: ignore فقط فایل‌های «track نشده» را نگه می‌دارد؛ اگر فایلی قبلاً
# کامیت شده باشد، اول باید از فهرست خارج شود:
#     git rm --cached .env
.env
.env.*
!.env.example
*.env
*.session
*.session-journal
*.session-wal

# آرشیو بکاپ کامل (شامل .env و دیتابیس) — محل نگهداری آن خصوصی است
B2-full-*.tar.gz
B2-backup-*.tar.gz
B2-backup-*.tar.gz.sha256
*bot-backup-*.tar.gz
backups/*.tar.gz
backups/*.zip

# ============================================================
#  داده‌ی زمان اجرا (per-instance، هرگز در مخزن)
# ============================================================
config/*.json
config/*.txt
config/archive/
config/tmp*.tmp
config/watchdog.lock
config/watchdog_pending.json
config/bot.pid

# نشانگر instance
# توجه: در همین clone عمداً یک .bot_instance با مقدار «bot2» track شده است تا
# این کلون همیشه ربات ۲ باشد و اجرای main.py/watchdog.py اشتباهی در مسیر
# داده‌ی ربات اصلی ننویسد. سایر کلون‌ها نشانگر خودشان را جدا نگه می‌دارند.
.bot_instance

# ============================================================
#  لاگ و کش
# ============================================================
logs/
*.log
*.log.*
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
#  خروجی‌های موقت و ابزارها
# ============================================================
backups/runtime/
*.tmp
*.bak_*
tmp/
